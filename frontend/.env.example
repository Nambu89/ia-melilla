# Backend Impuestify (rama demo/fiscal-ia-melilla) — branded 'Fiscal IA Melilla'
VITE_API_BASE_URL=http://g100ae8up9ehmq4w0mn9od97.178.238.227.50.sslip.io

# Backend del Tutor IA para opositores (proyecto opositor-ia, se despliega aparte).
# NO reutilizar VITE_API_BASE_URL: ese apunta al backend de Impuestify y la razon
# de ser de este proyecto es no depender de el. Endpoints publicos, sin login.
VITE_API_TUTOR_URL=http://localhost:8000

# Demo user precreado en backend (login automatico desde frontend)
VITE_DEMO_USER_EMAIL=demo@iamelilla.com
VITE_DEMO_USER_PASSWORD=changeme

# Branding (opcional, copys frontend)
VITE_BRAND_NAME=Fiscal IA Melilla
VITE_TERRITORY=Melilla

# Chatbot captador de leads (widget flotante). Consume /api/lead-chat del backend,
# que sólo existe si allí está LEADBOT_ENABLED=true.
# Cloudflare Turnstile es OPCIONAL: sin site key el widget funciona igual y no
# pide captcha. El backend sólo exige el token si tiene TURNSTILE_SECRET_KEY.
VITE_TURNSTILE_SITE_KEY=
